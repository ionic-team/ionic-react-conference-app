{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "schedule": ["every weekday before 11am"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchPackagePatterns": ["^@ionic/"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackagePatterns": ["^react", "^@types/react"],
      "groupName": "react"
    },
    {
      "matchPackageNames": ["react-router", "react-router-dom"],
      "groupName": "react-router"
    },
    {
      "matchPackagePatterns": ["^@capacitor/"],
      "groupName": "capacitor"
    },
    {
      "matchPackagePatterns": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite"
    },
    {
      "matchPackagePatterns": ["@testing-library", "prettier"],
      "groupName": "dev-tools"
    }
  ]
}
