{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "description": "Renovate may only open or update PRs on Mondays, 6-10am ET.",
  "timezone": "America/New_York",
  "minimumReleaseAge": "3 days",
  "schedule": ["* 6-10 * * 1"],
  "semanticCommits": "enabled",
  "ignorePaths": ["android/**", "ios/**"],
  "gitIgnoredAuthors": ["hi@ionicframework.com"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**", "!@ionic/eslint-config", "!@ionic/prettier-config"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react*"],
      "groupName": "react"
    },
    {
      "matchPackageNames": ["react-router", "react-router-dom"],
      "groupName": "react-router",
      "allowedVersions": "<7",
      "description": "@ionic/react-router@9 requires react-router >=6.4.0 and <7"
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/**"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": ["leaflet", "@types/leaflet"],
      "groupName": "leaflet"
    },
    {
      "matchPackageNames": ["@testing-library/**", "vitest", "jsdom", "@playwright/test"],
      "groupName": "testing"
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-react-*",
        "@ionic/eslint-config",
        "@ionic/prettier-config",
        "globals",
        "prettier",
        "typescript"
      ],
      "groupName": "dev-tools"
    },
    {
      "description": "Automerge minor and patch updates once CI passes. Majors and 0.x packages, where a minor can break, still need review.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "CI only tests the web build, so Capacitor updates still need review for native changes. Pinned so lockfile maintenance can't update it either.",
      "matchPackageNames": ["@capacitor/**"],
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
