{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "schedule": ["every weekday before 11am"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react/**"],
      "groupName": "react"
    },
    {
      "matchPackageNames": ["react-router", "react-router-dom"],
      "groupName": "react-router"
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": ["@testing-library/**", "prettier"],
      "groupName": "dev-tools"
    }
  ]
}
