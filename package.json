{
  "name": "ionic-react-conference-app",
  "version": "0.0.0",
  "description": "Ionic Conference App",
  "author": "Ionic Team <hi@ionicframework.com>",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "@types/leaflet": "^1.9.17",
    "@types/react-redux": "^7.1.34",
    "date-fns": "^4.0.0",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "reselect": "^5.0.0",
    "sass": "^1.85.1"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "ionic:serve": "vite",
    "ionic:build": "tsc && vite build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,tsx}\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "prettier": "@ionic/prettier-config"
}
